[Unit]
Description=Master Portfolio Dashboard v2 (Web API + UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/stock-dashboard
ExecStart=/usr/bin/node %h/apps/stock-dashboard/server.mjs
EnvironmentFile=%h/apps/stock-dashboard/.env
Restart=always
RestartSec=2
TimeoutStopSec=15

# Hardening (user-level systemd)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/apps/stock-dashboard/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=stock-dashboard

[Install]
WantedBy=default.target
