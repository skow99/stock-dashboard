# .env.example - skopiuj do .env i uzupelnij. NIE commituj .env do repozytorium.

# --- siec
SD_HOST=127.0.0.1
SD_PORT=8787
SD_BASE_PATH=/stock-dashboard
NODE_ENV=production

# --- bezpieczenstwo
# Wlacz, gdy aplikacja jest wystawiona przez HTTPS (Tailscale Serve, reverse proxy).
SD_COOKIE_SECURE=1
SD_TRUST_PROXY=1
SD_OPEN_REGISTRATION=0
SD_SESSION_TTL_HOURS=336
SD_SESSION_IDLE_HOURS=72
SD_MIN_PASSWORD_LENGTH=10
SD_LOGIN_MAX_ATTEMPTS=8
SD_LOGIN_LOCKOUT_MINUTES=15

# --- pierwsze uruchomienie (opcjonalne; dziala tylko gdy baza nie ma zadnego uzytkownika)
# Po zalozeniu konta USUN te dwie linie.
# SD_BOOTSTRAP_EMAIL=ja@example.com
# SD_BOOTSTRAP_PASSWORD=zmien-to-natychmiast

# --- dane
SD_DATA_DIR=./data
# SD_DB_PATH=./data/dashboard.db

# --- dane rynkowe
SD_QUOTE_TIMEOUT_MS=8000
SD_PRICE_HISTORY_FRESH_HOURS=6
SD_PORTFOLIO_CACHE_SECONDS=60
SD_EOD_TIMEZONE=Europe/Warsaw
SD_EOD_CUTOFF_HOUR=22
# SD_OFFLINE=1   # tryb testowy: zero zapytan do zrodel zewnetrznych

# --- webhook (fallback globalny; preferowany jest token per portfel z UI)
# STOCK_DASHBOARD_WEBHOOK_TOKEN=

# --- jezyk
# Jezyk uzywany, gdy klient nie wskaze innego przez Accept-Language ani ?lang=. Obslugiwane: pl, en.
SD_DEFAULT_LOCALE=pl

# --- logi
SD_LOG_LEVEL=info
